{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/shorthand-capability-corpus.schema.json",
  "title": "SheetOM Shorthand Capability Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "userAgent", "propertyManifestSha256", "derivation"],
      "properties": {
        "browser": { "const": "chromium" },
        "userAgent": { "type": "string", "minLength": 1 },
        "propertyManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "derivation": { "const": "computed-initial-longhands@1" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "property", "input", "source", "chromium", "mutationProbe"],
        "properties": {
          "id": { "type": "string", "pattern": "^shorthand\\.[a-z0-9-]+\\.concrete-default$" },
          "property": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "source": { "enum": ["generated", "manual"] },
          "chromium": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accepted", "items", "longhands", "shorthandValue", "shorthandPriority", "cssText"],
            "properties": {
              "accepted": { "const": true },
              "items": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string", "minLength": 1 }
              },
              "longhands": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value", "priority"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "value": { "type": "string" },
                    "priority": { "enum": ["", "important"] }
                  }
                }
              },
              "shorthandValue": { "type": "string" },
              "shorthandPriority": { "enum": ["", "important"] },
              "cssText": { "type": "string" }
            }
          },
          "mutationProbe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["longhand", "override"],
            "properties": {
              "longhand": { "type": "string", "minLength": 1 },
              "override": { "const": "inherit" }
            }
          }
        }
      }
    }
  }
}
