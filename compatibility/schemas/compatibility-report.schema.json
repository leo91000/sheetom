{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/compatibility-report.schema.json",
  "title": "SheetOM Compatibility Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "baseline", "summary", "evidence", "resolutions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [1, 2, 3, 4] },
    "packageVersion": { "type": "string" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wptCommit", "runtimes", "browsers"],
      "properties": {
        "wptCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "lightningcss": { "type": "string" },
        "cssTree": { "type": "string" },
        "syntaxEngineSet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lightningcss", "cssTree", "cssTokenizer"],
          "properties": {
            "lightningcss": { "type": "string" },
            "cssTree": { "type": "string" },
            "cssstyle": { "type": "string" },
            "cssTokenizer": { "type": "string" }
          }
        },
        "runtimes": { "type": "object" },
        "browsers": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "divergences", "excluded", "unexplained"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "divergences": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "unexplained": { "const": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationFixtures", "nativeWpt"],
      "properties": {
        "operationFixtures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "total"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "adapters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["adapter", "passed", "total"],
                "properties": {
                  "adapter": {
                    "enum": ["sheetom", "chromium", "firefox", "webkit"]
                  },
                  "version": { "type": "string" },
                  "passed": { "type": "integer", "minimum": 0 },
                  "total": { "type": "integer", "minimum": 0 },
                  "observations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["fixtureId", "operations"],
                      "properties": {
                        "fixtureId": { "type": "string" },
                        "operations": {
                          "type": "array",
                          "items": { "type": "object" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "shorthandGrammar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiles", "passed", "total", "contractsSha256", "observationsSha256"],
          "properties": {
            "profiles": { "enum": [23, 24] },
            "passed": { "enum": [92, 96] },
            "total": { "enum": [92, 96] },
            "contractsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "observationsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "nativeWpt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "version", "sha256", "passed", "total"],
            "properties": {
              "engine": { "enum": ["chrome", "firefox", "safari"] },
              "version": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "passed": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "resolutions": { "type": "array" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } } },
      "then": {
        "properties": {
          "baseline": {
            "type": "object",
            "required": ["lightningcss", "cssTree"],
            "properties": {
              "lightningcss": { "type": "string" },
              "cssTree": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "enum": [2, 3, 4] } } },
      "then": {
        "properties": {
          "baseline": {
            "type": "object",
            "required": ["syntaxEngineSet"],
            "properties": {
              "syntaxEngineSet": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 4 } } },
      "then": {
        "properties": {
          "evidence": {
            "type": "object",
            "required": ["shorthandGrammar"],
            "properties": {
              "shorthandGrammar": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
