{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/value-capability-corpus.schema.json",
  "title": "SheetOM Value Capability Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "major"],
      "properties": {
        "browser": { "const": "chromium" },
        "major": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "property", "input", "accepted"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "property": { "type": "string" },
          "input": { "type": "string" },
          "accepted": { "type": "boolean" },
          "observable": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "accepted": { "const": true } } },
            "then": {
              "properties": { "observable": { "type": "string" } },
              "required": ["observable"]
            },
            "else": {
              "not": {
                "properties": { "observable": { "type": "string" } },
                "required": ["observable"]
              }
            }
          }
        ]
      }
    }
  }
}
