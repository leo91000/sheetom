{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/webref-semantic-terminals.schema.json",
  "title": "Webref Semantic Terminal Samples",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "description", "terminals"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "coverage", "evidence", "values"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "coverage": { "enum": ["representative", "branch-complete"] },
          "evidence": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
