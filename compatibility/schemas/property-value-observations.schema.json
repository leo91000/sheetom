{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/property-value-observations.schema.json",
  "title": "Chromium Property Value Probe Observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "baseline", "accepted"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "userAgent", "compatMode", "propertyCount", "probeCount", "acceptedCount", "rejectedCount", "atomicNoOpCount", "probesSha256"],
      "properties": {
        "browser": { "const": "chromium" },
        "userAgent": { "type": "string", "minLength": 1 },
        "compatMode": { "const": "CSS1Compat" },
        "propertyCount": { "type": "integer", "minimum": 1 },
        "probeCount": { "type": "integer", "minimum": 1 },
        "acceptedCount": { "type": "integer", "minimum": 1 },
        "rejectedCount": { "type": "integer", "minimum": 1 },
        "atomicNoOpCount": { "type": "integer", "minimum": 1 },
        "probesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property", "probe", "observable", "cssText", "items"],
        "properties": {
          "property": { "type": "string" },
          "probe": { "type": "string" },
          "observable": { "type": "string" },
          "cssText": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
