{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheetom.dev/schemas/number-result-math-corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "probes", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "major", "userAgent", "propertyManifestSha256"],
      "properties": {
        "browser": { "const": "chromium" },
        "major": { "const": 151 },
        "userAgent": { "type": "string", "minLength": 1 },
        "propertyManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "input"],
        "properties": {
          "branch": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "property",
          "shorthand",
          "integration",
          "branch",
          "input",
          "accepted"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "property": { "type": "string", "minLength": 1 },
          "shorthand": { "type": "boolean" },
          "integration": {
            "enum": ["direct-number", "composite-property"]
          },
          "branch": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "accepted": { "type": "boolean" },
          "observable": { "type": "string" },
          "cssText": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
