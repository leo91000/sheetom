{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/native-grammar-inventory.schema.json",
  "title": "SheetOM Native Grammar Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "profiles", "properties", "propertyBranches"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser",
        "userAgent",
        "propertyManifestSha256",
        "shorthandCapabilitiesSha256",
        "shorthandGrammarContractsSha256",
        "valueCapabilitiesSha256",
        "derivation"
      ],
      "properties": {
        "browser": { "const": "chromium" },
        "userAgent": { "type": "string", "minLength": 1 },
        "propertyManifestSha256": { "$ref": "#/$defs/sha256" },
        "shorthandCapabilitiesSha256": { "$ref": "#/$defs/sha256" },
        "shorthandGrammarContractsSha256": { "$ref": "#/$defs/sha256" },
        "valueCapabilitiesSha256": { "$ref": "#/$defs/sha256" },
        "derivation": { "const": "manifest-profile-property-branches@1" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codec", "properties", "contractCaseIds"],
        "properties": {
          "codec": { "type": "string", "minLength": 1 },
          "properties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "contractCaseIds": {
            "type": "array",
            "minItems": 4,
            "items": { "type": "string", "pattern": "^grammar\\.[a-z0-9-]+\\.[a-z0-9-]+$" }
          }
        }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 129,
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property", "codec", "breadthCaseId", "propertyBranchIds"],
        "properties": {
          "property": { "type": "string", "minLength": 1 },
          "codec": { "type": "string", "minLength": 1 },
          "breadthCaseId": { "type": "string", "pattern": "^shorthand\\.[a-z0-9-]+\\.concrete-default$" },
          "propertyBranchIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^native\\.[a-z0-9-]+\\.[a-z0-9-]+$" }
          }
        }
      }
    },
    "propertyBranches": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "property", "branch", "input", "accepted", "chromium"],
        "properties": {
          "id": { "type": "string", "pattern": "^native\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
          "property": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "accepted": { "type": "boolean" },
          "preserves": { "type": "string", "pattern": "^native\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
          "chromium": { "$ref": "#/$defs/observation" }
        },
        "allOf": [
          {
            "if": { "properties": { "accepted": { "const": false } } },
            "then": {
              "properties": {
                "preserves": { "type": "string" }
              },
              "required": ["preserves"]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "accepted", "items", "longhands", "shorthandValue", "priority", "cssText"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "items": { "type": "array", "items": { "type": "string" } },
        "longhands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "priority"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" },
              "priority": { "type": "string" }
            }
          }
        },
        "shorthandValue": { "type": "string" },
        "priority": { "type": "string" },
        "cssText": { "type": "string" }
      }
    }
  }
}
