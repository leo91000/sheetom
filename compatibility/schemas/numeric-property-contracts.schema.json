{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leo91000/sheetom/compatibility/schemas/numeric-property-contracts.schema.json",
  "title": "Numeric Property Contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "description",
    "extensionFamilies",
    "additionalProperties",
    "probes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "extensionFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
