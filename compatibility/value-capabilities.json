    { "id": "grid.invalid-subgrid-track", "property": "grid-template-columns", "input": "subgrid 1px", "accepted": false },
    { "id": "anchor.anchor-size", "property": "width", "input": "anchor-size(width)", "accepted": true, "observable": "anchor-size(width)" },
