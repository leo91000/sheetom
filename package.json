{
  "name": "sheetom",
  "version": "0.1.0",
  "description": "A browser-compatible mutable CSSOM for JavaScript runtimes",
  "keywords": [
    "css",
    "cssom",
    "stylesheet",
    "rust",
    "napi",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo91000/sheetom.git"
  },
  "bugs": {
    "url": "https://github.com/leo91000/sheetom/issues"
  },
  "homepage": "https://github.com/leo91000/sheetom#readme",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    ".",
    "packages/native-*",
    "packages/wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "engine-abi.json",
    "native/index.cjs",
    "native/resolve-target.cjs",
    "docs/api.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "optionalDependencies": {
    "@sheetom/native-darwin-arm64": "0.1.0",
    "@sheetom/native-darwin-x64": "0.1.0",
    "@sheetom/native-linux-arm-gnueabihf": "0.1.0",
    "@sheetom/native-linux-arm-musleabihf": "0.1.0",
    "@sheetom/native-linux-arm64-gnu": "0.1.0",
    "@sheetom/native-linux-arm64-musl": "0.1.0",
    "@sheetom/native-linux-ppc64-gnu": "0.1.0",
    "@sheetom/native-linux-s390x-gnu": "0.1.0",
    "@sheetom/native-linux-x64-gnu": "0.1.0",
    "@sheetom/native-linux-x64-musl": "0.1.0",
    "@sheetom/native-win32-arm64-msvc": "0.1.0",
    "@sheetom/native-win32-ia32-msvc": "0.1.0",
    "@sheetom/native-win32-x64-msvc": "0.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changeset.ts",
    "ci:scripts:test": "node --test scripts/*.test.ts",
    "check": "npm run repository:check && npm run generate:engine-abi && npm run native:packages && npm run typecheck && npm run test:unit && npm run conformance:validate && npm run generate:native-properties && npm run generate:css-style-declaration-types && npm run docs:check && npm run build && npm run runtime:check && npm run pack:test",
    "conformance:validate": "node scripts/validate-conformance.ts",
    "conformance:drift": "node scripts/check-wpt-drift.ts",
    "conformance:record": "node scripts/record-compatibility.ts",
    "docs:build": "typedoc",
    "docs:check": "node scripts/check-documentation.ts && typedoc --emit none",
    "fuzz": "vitest run --project fuzz",
    "generate:engine-abi": "node scripts/engine-abi.ts --check",
    "generate:css-style-declaration-types": "node scripts/generate-css-style-declaration-types.ts --check",
    "generate:properties": "node scripts/generate-chromium-properties.ts",
    "generate:native-grammar": "node scripts/generate-native-grammar-inventory.ts --check",
    "generate:native-properties": "node scripts/generate-native-property-catalog.ts --check",
    "generate:property-values": "node scripts/generate-property-value-observations.ts --check",
    "generate:shorthand-capabilities": "node scripts/generate-shorthand-capabilities.ts --check",
    "generate:shorthand-grammar": "node scripts/generate-shorthand-grammar-observations.ts --check",
    "generate:webref-property-branches": "node scripts/generate-webref-property-branches.ts --check",
    "native:build": "napi build --platform --release --package sheetom-native --manifest-path crates/sheetom-native/Cargo.toml --output-dir native --no-js --dts sheetom-native.d.ts && node scripts/install-local-native-artifact.ts",
    "native:build:target": "node scripts/build-native-target.ts",
    "native:build:cross-target": "node scripts/build-native-cross-target.ts",
    "native:collect": "node scripts/collect-native-artifacts.ts",
    "native:packages": "node scripts/sync-native-packages.ts --check",
    "native:check": "npm run native:core-check && npm run native:vendor-check",
    "native:core-check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "native:vendor-check": "cargo test --manifest-path vendor/cssparser/Cargo.toml --target-dir target -p cssparser && cargo test --manifest-path vendor/cssparser/Cargo.toml --target-dir target -p cssparser-color && cargo test --manifest-path vendor/lightningcss/Cargo.toml --target-dir target --lib",
    "native:test": "npm run native:build && npm run build && node scripts/test-native-loader.ts && node scripts/test-native-foundation.ts && node scripts/test-native-crash-safety.ts && node scripts/test-native-operation-fixtures.ts && node scripts/check-native-public-corpus.ts && npm run native:numeric-contracts && npm run native:property-contracts",
    "native:numeric-contracts": "node scripts/check-property-value-matrix.ts --contract=compatibility/numeric-property-contracts.json",
    "native:property-contracts": "node scripts/check-property-value-matrix.ts",
    "native:webref-property-branches": "node scripts/check-webref-property-branches.ts",
    "wasm:build": "node scripts/build-wasm-engine.ts && tsdown --config packages/wasm/tsdown.facade.config.ts && node scripts/parameterize-wasm-facade.ts packages/wasm/dist/facade.js packages/wasm/dist/facade_factory.js && tsdown --config packages/wasm/tsdown.index.config.ts && node scripts/finalize-wasm-package.ts",
    "wasm:check": "cargo fmt --all --check && cargo clippy -p sheetom-wasm --target wasm32-unknown-unknown -- -D warnings && cargo test -p sheetom-wasm && node scripts/sync-wasm-package.ts --check",
    "wasm:test": "node scripts/test-wasm-backend.ts",
    "wasm:test:browsers": "node scripts/test-wasm-browsers.ts",
    "wasm:test:bundlers": "node scripts/test-wasm-bundlers.ts",
    "wasm:test:memory": "node --expose-gc scripts/test-wasm-memory-soak.ts",
    "wasm:test:performance": "node scripts/test-wasm-browser-performance.ts",
    "wasm:benchmark": "node scripts/benchmark.ts --module packages/wasm/dist/index.js --wasm-binary packages/wasm/dist/sheetom_wasm_bg.wasm",
    "native:browser-differential": "npm run native:build && npm run build && npm run native:browser-differential:run",
    "native:browser-differential:run": "node scripts/native-browser-differential.ts && node scripts/browser-longhand-differential.ts && node scripts/browser-longhand-composite-differential.ts && node scripts/browser-geometric-differential.ts && node scripts/font-face-browser-differential.ts && node scripts/rule-browser-differential.ts",
    "wpt:paths": "node scripts/list-wpt-paths.ts",
    "benchmark": "npm run build && node scripts/benchmark.ts",
    "pack:test": "node scripts/test-package.ts",
    "record:shorthand-capabilities": "node scripts/generate-shorthand-capabilities.ts --record",
    "record:engine-abi": "node scripts/engine-abi.ts --record",
    "record:css-style-declaration-types": "node scripts/generate-css-style-declaration-types.ts --record",
    "record:native-grammar": "node scripts/generate-native-grammar-inventory.ts --record",
    "record:css-math": "node scripts/record-css-math-capabilities.ts",
    "record:number-result-math": "node scripts/record-number-result-math-capabilities.ts",
    "record:native-properties": "node scripts/generate-native-property-catalog.ts --record",
    "record:native-packages": "node scripts/sync-native-packages.ts --record",
    "record:property-values": "node scripts/generate-property-value-observations.ts --record",
    "record:shorthand-grammar": "node scripts/generate-shorthand-grammar-observations.ts --record",
    "record:webref-property-branches": "node scripts/generate-webref-property-branches.ts --record",
    "release:verify": "node scripts/verify-release.ts",
    "release:manifest": "node scripts/write-release-artifact-manifest.ts",
    "repository:check": "node scripts/check-repository-cleanliness.ts",
    "runtime:check": "node scripts/check-runtime-artifacts.ts",
    "report:property-values": "node scripts/check-property-value-matrix.ts --allow-mismatches",
    "report:webref-property-branches": "node scripts/check-webref-property-branches.ts --allow-mismatches",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:matrix": "SHEETOM_BROWSER_MATRIX=1 vitest run --project browser",
    "test:differential": "npm run build && node scripts/browser-differential.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@napi-rs/cli": "3.8.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/css-tree": "^2.3.10",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@webref/css": "8.7.1",
    "ajv": "^8.20.0",
    "binaryen": "131.0.0",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "fast-check": "^4.9.0",
    "playwright": "^1.62.1",
    "rollup": "4.62.4",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "webpack": "5.109.2"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": ">=24.12"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "sheetom-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
