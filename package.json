{
  "name": "sheetom",
  "version": "0.1.0-rc.6",
  "description": "A browser-compatible authoring CSSOM for server-side JavaScript runtimes",
  "keywords": [
    "css",
    "cssom",
    "stylesheet",
    "lightningcss"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo91000/sheetom.git"
  },
  "bugs": {
    "url": "https://github.com/leo91000/sheetom/issues"
  },
  "homepage": "https://github.com/leo91000/sheetom#readme",
  "packageManager": "npm@11.16.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "native",
    "compatibility/baselines",
    "compatibility/browser-geometric-contracts.json",
    "compatibility/schemas",
    "compatibility/native-grammar-inventory.json",
    "compatibility/numeric-property-contracts.json",
    "compatibility/number-result-math-capabilities.json",
    "compatibility/shorthand-capabilities.json",
    "compatibility/shorthand-grammar-contracts.json",
    "compatibility/shorthand-grammar-observations.json",
    "compatibility/value-capabilities.json",
    "compatibility/WPT-LICENSE.md",
    "docs/api.md",
    "docs/releasing.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changeset.mjs",
    "ci:scripts:test": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run conformance:validate && npm run generate:native-properties && npm run docs:check && npm run build && npm run runtime:check && npm run pack:test",
    "conformance:validate": "node scripts/validate-conformance.mjs",
    "conformance:drift": "node scripts/check-wpt-drift.mjs",
    "conformance:record": "node scripts/record-compatibility.mjs",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none",
    "fuzz": "vitest run --project fuzz",
    "generate:properties": "node scripts/generate-chromium-properties.mjs",
    "generate:native-grammar": "node scripts/generate-native-grammar-inventory.mjs --check",
    "generate:native-properties": "node scripts/generate-native-property-catalog.mjs --check",
    "generate:property-values": "node scripts/generate-property-value-observations.mjs --check",
    "generate:shorthand-capabilities": "node scripts/generate-shorthand-capabilities.mjs --check",
    "generate:shorthand-grammar": "node scripts/generate-shorthand-grammar-observations.mjs --check",
    "generate:webref-property-branches": "node scripts/generate-webref-property-branches.mjs --check",
    "native:build": "napi build --platform --release --package sheetom-native --manifest-path crates/sheetom-native/Cargo.toml --output-dir native --no-js --dts sheetom-native.d.ts",
    "native:build:target": "node scripts/build-native-target.mjs",
    "native:collect": "node scripts/collect-native-artifacts.mjs",
    "native:check": "npm run native:core-check && npm run native:vendor-check",
    "native:core-check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "native:vendor-check": "cargo test --manifest-path vendor/cssparser/Cargo.toml --target-dir target -p cssparser && cargo test --manifest-path vendor/cssparser/Cargo.toml --target-dir target -p cssparser-color && cargo test --manifest-path vendor/lightningcss/Cargo.toml --target-dir target --lib",
    "native:test": "npm run native:build && npm run build && node scripts/test-native-loader.mjs && node scripts/test-native-foundation.mjs && node scripts/test-native-crash-safety.mjs && node scripts/test-native-operation-fixtures.mjs && node scripts/check-native-public-corpus.mjs && npm run native:numeric-contracts && npm run native:property-contracts",
    "native:numeric-contracts": "node scripts/check-property-value-matrix.mjs --contract=compatibility/numeric-property-contracts.json",
    "native:property-contracts": "node scripts/check-property-value-matrix.mjs",
    "native:webref-property-branches": "node scripts/check-webref-property-branches.mjs",
    "native:browser-differential": "npm run native:build && npm run build && npm run native:browser-differential:run",
    "native:browser-differential:run": "node scripts/native-browser-differential.mjs && node scripts/browser-longhand-differential.mjs && node scripts/browser-longhand-composite-differential.mjs && node scripts/browser-geometric-differential.mjs && node scripts/font-face-browser-differential.mjs && node scripts/rule-browser-differential.mjs",
    "wpt:paths": "node scripts/list-wpt-paths.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "pack:test": "node scripts/test-package.mjs",
    "record:shorthand-capabilities": "node scripts/generate-shorthand-capabilities.mjs --record",
    "record:native-grammar": "node scripts/generate-native-grammar-inventory.mjs --record",
    "record:css-math": "node scripts/record-css-math-capabilities.mjs",
    "record:number-result-math": "node scripts/record-number-result-math-capabilities.mjs",
    "record:native-properties": "node scripts/generate-native-property-catalog.mjs --record",
    "record:property-values": "node scripts/generate-property-value-observations.mjs --record",
    "record:shorthand-grammar": "node scripts/generate-shorthand-grammar-observations.mjs --record",
    "record:webref-property-branches": "node scripts/generate-webref-property-branches.mjs --record",
    "release:verify": "node scripts/verify-release.mjs",
    "runtime:check": "node scripts/check-runtime-artifacts.mjs",
    "report:property-values": "node scripts/check-property-value-matrix.mjs --allow-mismatches",
    "report:webref-property-branches": "node scripts/check-webref-property-branches.mjs --allow-mismatches",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:matrix": "SHEETOM_BROWSER_MATRIX=1 vitest run --project browser",
    "test:differential": "npm run build && node scripts/browser-differential.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@csstools/css-tokenizer": "4.0.0",
    "@napi-rs/cli": "3.8.3",
    "@types/css-tree": "^2.3.10",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@webref/css": "8.7.1",
    "ajv": "^8.20.0",
    "css-tree": "3.2.1",
    "fast-check": "^4.9.0",
    "lightningcss": "1.33.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "sheetom-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
